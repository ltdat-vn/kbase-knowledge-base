# =============================================================================
# KBase Environment Configuration Template
# Sao chép tệp này thành .env và điền các khóa bí mật của bạn.
# =============================================================================

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình Gemini AI mặc định (Khuyến nghị: gemini-3.8-flash hoặc gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL cục bộ
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/kbasedb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Cấu hình dịch vụ AI Python (FastAPI RAG)
AI_SERVICE_URL=http://localhost:8000
